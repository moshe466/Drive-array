<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/activity_horizontal_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/GLZguideline"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/ColorAqua"
                android:gravity="center"
                android:id="@+id/EyeTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eyeOpening"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/Eye"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/eyeOpening"
                android:layout_below="@+id/EyeTxt">
                <Spinner
                    android:layout_gravity="start"
                    android:id="@+id/EyeS"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:spinnerMode="dropdown"
                    style="@style/Widget.AppCompat.Spinner.Underlined"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/ColorAqua"
                android:gravity="center"
                android:id="@+id/VerbalTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/verbal"
                android:layout_below="@+id/Eye"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/Verbal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/VerbalTxt">
                <Spinner
                    android:layout_gravity="start"
                    android:id="@+id/VerbalS"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:spinnerMode="dropdown"
                    style="@style/Widget.AppCompat.Spinner.Underlined"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/ColorAqua"
                android:gravity="center"
                android:id="@+id/MotorTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/motor"
                android:layout_below="@+id/Verbal"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/Motor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/MotorTxt">
                <Spinner
                    android:layout_gravity="start"
                    android:id="@+id/MotorS"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:spinnerMode="dropdown"
                    style="@style/Widget.AppCompat.Spinner.Underlined"/>
            </com.google.android.material.textfield.TextInputLayout>
        </RelativeLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/convinient"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/GLZguideline"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="19sp"
            android:gravity="start|top"
            android:id="@+id/GLZGrade"
            android:background="@drawable/btns_new"
            android:padding="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:id="@+id/GLZInfBG"
            android:background="@drawable/btns_new"
            android:padding="14dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:drawablePadding="16dp"
            android:paddingStart="7dp"
            android:paddingEnd="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/GLZGrade">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="@color/Black"
                android:contentDescription="@string/app_name"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                app:srcCompat="@drawable/ic_info"/>
            <View
                android:background="@color/Black"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:scrollbarSize="4dp"
                android:textSize="16sp"
                android:ellipsize="end"
                android:id="@+id/GLZInf"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/GLZguideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.64"/>
</androidx.constraintlayout.widget.ConstraintLayout>
