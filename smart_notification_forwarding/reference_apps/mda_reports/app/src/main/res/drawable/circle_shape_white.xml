<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="oval"
            android:innerRadiusRatio="3">
            <solid android:color="@color/ShadowEnd"/>
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape
            android:shape="oval"
            android:innerRadiusRatio="3">
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
</layer-list>
