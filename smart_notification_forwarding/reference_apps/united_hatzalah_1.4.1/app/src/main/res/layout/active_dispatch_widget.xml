<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_widget_root"
    android:background="@drawable/active_dispatch_widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ad_empty_block"
        android:padding="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="50px"
            android:textColor="#222222"
            android:gravity="center"
            android:id="@+id/ad_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="אין הזנקה פעילה"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="50px"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/ad_refresh"
            android:background="@drawable/active_dispatch_nav_btn"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="רענון"
            android:includeFontPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ad_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <ImageView
            android:id="@+id/ad_accent"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:src="@drawable/active_dispatch_nav_btn"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="42px"
            android:textStyle="bold"
            android:textColor="#1a1a1a"
            android:gravity="center"
            android:id="@+id/ad_title"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:includeFontPadding="false"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ad_body"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ad_row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">
                <TextView
                    android:textSize="50px"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:id="@+id/ad_1221"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="1221"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"/>
                <TextView
                    android:textSize="50px"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:id="@+id/ad_when"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="@drawable/active_dispatch_divider"
                android:scaleType="fitXY"
                android:contentDescription="@null"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ad_row_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">
                <TextView
                    android:textSize="50px"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/ad_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"/>
                <TextView
                    android:textSize="50px"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:id="@+id/ad_urgency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="@drawable/active_dispatch_divider"
                android:scaleType="fitXY"
                android:contentDescription="@null"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="50px"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/ad_location"
                    android:background="@drawable/active_dispatch_loc_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ad_row_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">
                <TextView
                    android:textSize="50px"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/ad_navigate"
                    android:background="@drawable/active_dispatch_waze_btn"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="לניווט בוויז"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="50px"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:id="@+id/ad_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="50px"
                android:textColor="#333333"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/ad_referring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ad_refresh_slot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="50px"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ad_refresh_active"
                android:background="@drawable/active_dispatch_nav_btn"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="רענון"
                android:includeFontPadding="false"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
