<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_widget_root"
    android:background="@drawable/active_dispatch_widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ad_empty_block"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="11sp"
            android:textColor="#222222"
            android:gravity="center"
            android:id="@+id/ad_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="אין הזנקה פעילה"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/ad_refresh"
            android:background="@drawable/active_dispatch_nav_btn"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="רענון"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ad_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <ImageView
                    android:id="@+id/ad_accent"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:src="@drawable/active_dispatch_nav_btn"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ad_row_when"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="28dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:gravity="center"
                        android:id="@+id/ad_1221"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="1221"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:gravity="center"
                        android:id="@+id/ad_when"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="@drawable/active_dispatch_divider"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ad_row_type"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/ad_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:gravity="center"
                        android:id="@+id/ad_urgency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/ad_location"
                    android:background="@drawable/active_dispatch_loc_bg"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:maxLines="2"
                    android:textDirection="rtl"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/ad_referring"
                    android:paddingTop="4dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="28dp"
                    android:maxLines="2"
                    android:textDirection="rtl"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ad_row_nav"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ad_navigate"
                android:background="@drawable/active_dispatch_waze_btn_round"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ניווט"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ad_refresh_active"
                android:background="@drawable/active_dispatch_nav_btn"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="רענון"
                android:layout_weight="1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
