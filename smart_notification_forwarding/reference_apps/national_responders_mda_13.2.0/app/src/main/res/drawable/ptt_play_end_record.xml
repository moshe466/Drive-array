<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/record"/>
            <size
                android:height="100dp"
                android:width="100dp"/>
            <stroke
                android:width="4dp"
                android:color="@color/record"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="40dp"
        android:width="40dp"
        android:drawable="@drawable/record"/>
</layer-list>
