<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/shortcut_width"
    android:layout_height="@dimen/shortcut_width"
    android:layout_margin="2dp">
    <ImageView
        android:id="@+id/img_emptyShortcut"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/shortcut_oval_border_gray"/>
    <RelativeLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/rl_button1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/button_menu_background"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/image_view"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_16"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:gravity="bottom"
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שעון"
            android:lines="2"
            android:layout_alignParentBottom="true"
            android:textAlignment="center"/>
        <RelativeLayout
            android:id="@+id/rl_close"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="1dp"
            app:layout_constraintLeft_toLeftOf="@+id/rl_button"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:background="@drawable/button_menu_close"
                android:visibility="visible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <ImageView
                    android:id="@+id/img_close"
                    android:padding="4dp"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/remove"
                    android:tint="@color/grey_text"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
