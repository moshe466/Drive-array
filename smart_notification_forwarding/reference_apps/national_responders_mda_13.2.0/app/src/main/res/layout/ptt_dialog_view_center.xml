<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="110dp">
    <RelativeLayout
        android:id="@+id/ll_main"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:orientation="vertical"
            android:background="@color/ptt_background_default"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="0dp">
            <View
                android:id="@+id/rl_background"
                android:background="@color/red_buttons"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"/>
            <View
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="31dp"
                android:layout_marginRight="0dp"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/iv_close"
                android:padding="5dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                app:srcCompat="@drawable/ic_close_24dp"/>
            <SeekBar
                android:id="@+id/sb_volume"
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:max="15"
                android:progress="5"
                android:layout_weight="1"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"/>
            <ImageView
                android:id="@+id/img_silence"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="4dp"
                android:tint="@color/red_buttons"
                android:layout_weight="1"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                app:srcCompat="@drawable/ic_volume_off_red"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginRight="100dp"
                android:text="זמין"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <ProgressBar
                android:id="@+id/pb_wait"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textStyle="bold"
                android:textColor="#ffd03030"
                android:gravity="right"
                android:id="@+id/tv_message"
                android:paddingLeft="60dp"
                android:paddingRight="100dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text=""
                android:layout_alignParentBottom="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingRight="100dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_alignParentBottom="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18dp"
                        android:textStyle="normal"
                        android:gravity="right"
                        android:id="@+id/tv_name"
                        android:paddingLeft="3dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="ישראל ישראלי"
                        android:lines="1"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/img_verification1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/img_verification1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/img_verification2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/verification"/>
                    <ImageView
                        android:id="@+id/img_verification2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/verification_blue"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/red_buttons"
                    android:gravity="right"
                    android:id="@+id/tv_name2"
                    android:paddingLeft="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ישראל ישראלי"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_error"
                android:background="#ffa91d26"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="fgfgfg"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginRight="4dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <ImageView
            android:gravity="left"
            android:id="@+id/iv_play"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ptt_play_record"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
</RelativeLayout>
