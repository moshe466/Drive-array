<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="300dp"
    android:layout_height="420dp">
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@color/red_text"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/required_permission_ptt"/>
    <ListView
        android:id="@+id/rv_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:divider="#00000000"
        android:dividerHeight="10dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp">
        <Button
            android:textColor="@color/red_buttons"
            android:id="@+id/btn_get_all_permission"
            android:background="@drawable/red_btn_border_4"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:text="@string/allow_all"
            android:layout_alignParentLeft="true"/>
        <Button
            android:textColor="@color/red_buttons"
            android:id="@+id/btn_close"
            android:background="@drawable/red_btn_border_4"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:text="@string/close"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
