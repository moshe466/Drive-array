<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/red_background"
    android:padding="3dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_close"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:text="X"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/choose_status"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_status"
            android:layout_alignParentRight="true"
            style="@style/redTitleStyle"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/choose_status_explanation"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/choose_status_explanation"
        android:layout_alignParentRight="true"/>
    <ListView
        android:id="@+id/listview"
        android:background="@drawable/white_and_blue_border_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/mada_red"
        android:dividerHeight="1dp"
        android:layout_weight="1"/>
</LinearLayout>
