<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/border_squer_green"
    android:padding="16dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/img_close"
            android:paddingBottom="10dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/close"
            android:paddingStart="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/red_buttons"
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_bike"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/redTitleStyle"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/txt_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="שלום רחל, מספר מנוי: 123456"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
        <RelativeLayout
            android:id="@+id/rl_operationalCode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/txt_description">
            <ImageView
                android:background="@drawable/sign_up_text_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <EditText
                    android:textSize="16sp"
                    android:gravity="start|bottom"
                    android:id="@+id/et_operationalCode"
                    android:background="@null"
                    android:nextFocusDown="@+id/autocomplete"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="11dp"
                    android:hint="@string/operational_code"
                    android:inputType="number"
                    android:layout_marginEnd="25dp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_address"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/rl_operationalCode">
            <ImageView
                android:background="@drawable/sign_up_text_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"/>
            <ImageView
                android:id="@+id/img_currentLocation"
                android:padding="6dp"
                android:layout_width="35dp"
                android:layout_height="50dp"
                android:src="@drawable/address_icon"
                android:tint="@color/red_text"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.groboot.mdaemergency.ui.views.ClearableAutoCompleteTextView
                    android:textSize="16sp"
                    android:gravity="start|bottom"
                    android:id="@+id/autocomplete"
                    android:background="@null"
                    android:nextFocusDown="@+id/et_comment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/enter_address"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:layout_marginEnd="25dp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </RelativeLayout>
        <TextView
            android:id="@+id/tv_lastAddresses"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/recent_addresses"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_address"/>
        <HorizontalScrollView
            android:id="@+id/scrl_btnAddresses"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_lastAddresses">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_btnAddresses"
                android:padding="2dp"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <RelativeLayout
            android:id="@+id/rl_details"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/scrl_btnAddresses">
            <ImageView
                android:background="@drawable/sign_up_text_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <EditText
                    android:textSize="16sp"
                    android:gravity="start|bottom"
                    android:id="@+id/et_comment"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="11dp"
                    android:hint="@string/comment"
                    android:inputType="text"
                    android:layout_marginEnd="25dp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </RelativeLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/green_two"
            android:gravity="center"
            android:id="@+id/btn_startShift"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/update_shift_data_"
            app:layout_constraintEnd_toStartOf="@+id/btn_stopShift"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_details"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/green_two"
            android:gravity="center"
            android:id="@+id/btn_stopShift"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/stop_shift"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_startShift"
            app:layout_constraintTop_toBottomOf="@+id/rl_details"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
