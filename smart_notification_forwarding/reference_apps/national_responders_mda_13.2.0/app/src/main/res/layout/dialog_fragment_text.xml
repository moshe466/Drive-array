<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:background="#55ffffff"
    android:padding="20dp"
    android:layout_width="wrap_content"
    android:layout_height="260dp"
    android:layout_margin="20dp"
    android:minWidth="500dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="6dp"
        android:layout_weight="1">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/mada_red_dark"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:gravity="top"
            android:id="@+id/et_text"
            android:padding="2dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="אחר"
            android:minLines="3"
            android:singleLine="false"
            android:inputType="textImeMultiLine"
            android:imeActionLabel="Hebrew"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="50dp">
        <Button
            android:textSize="20dp"
            android:id="@+id/btn_next"
            android:background="@drawable/button_green"
            android:padding="10dp"
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:text="שמור"
            android:drawableLeft="@drawable/menu_save"
            android:layout_alignParentBottom="true"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/btn_clear"
            android:background="@drawable/button_green"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:layout_marginRight="136dp"
            android:text="נקה נתונים"
            android:drawableRight="@drawable/button_x"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/btn_back"
            android:background="@drawable/button_green"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:text="חזרה"
            android:drawableRight="@drawable/arrow_black_right"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
