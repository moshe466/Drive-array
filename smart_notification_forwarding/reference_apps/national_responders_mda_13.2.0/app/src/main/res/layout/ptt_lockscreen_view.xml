<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ff000000"
    android:layout_width="220dp"
    android:layout_height="260dp">
    <RelativeLayout
        android:id="@+id/main_layout"
        android:layout_width="220dp"
        android:layout_height="260dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_main"
            android:background="@color/ptt_play_green"
            android:padding="3dp"
            android:layout_width="220dp"
            android:layout_height="260dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="#ff000000"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="#0000aa00"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:baselineAligned="false">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/white"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/tv_name"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="dsfgdf"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#ffff2f3c"
                        android:gravity="center"
                        android:id="@+id/tv_name2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="sdgf sdgf"/>
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:layout_width="110dp"
                        android:layout_height="110dp">
                        <ProgressBar
                            android:id="@+id/pb_wait"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:layout_centerInParent="true"/>
                        <ImageView
                            android:gravity="left"
                            android:padding="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/button_oval_border_gray"
                            android:layout_alignParentLeft="true"/>
                        <ImageView
                            android:gravity="left"
                            android:id="@+id/iv_play"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ptt_play"
                            android:layout_alignParentLeft="true"/>
                    </RelativeLayout>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="dfhgdfhg"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_message"
                        android:background="#00000000"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="26dp"/>
                    <SeekBar
                        android:id="@+id/sb_volume"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:max="15"
                        android:progress="5"
                        android:layout_alignParentBottom="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_log"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ListView
                        android:id="@+id/lv_log"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:id="@+id/btn_send"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="4dp"
                            android:text="send"/>
                        <EditText
                            android:id="@+id/et_message"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="type message"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#ffeeeeee"
            android:gravity="center"
            android:id="@+id/btn_moveToApp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="X"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</FrameLayout>
