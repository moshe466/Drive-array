<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_data_views"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_car"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="20dp"
                    android:textColor="@color/grayDark"
                    android:gravity="center"
                    android:id="@+id/tv_car"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:text="hhhh"
                    android:drawableRight="@drawable/ic_drive_eta_black_24dp"/>
                <View
                    android:background="@color/grayDarkDark"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
            </LinearLayout>
        </RelativeLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_margin="2dp"
            style="@style/TextInputLayout">
            <com.groboot.mdaemergency.ui.views.SpinnerEditText
                android:id="@+id/sf_station"
                android:hint="תחנה"
                app:SearchVisible="true"
                style="@style/EditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_margin="2dp"
            android:layout_weight="1"
            style="@style/TextInputLayout">
            <com.groboot.mdaemergency.ui.views.TimeField
                android:id="@+id/et_from"
                android:hint="משעה"
                style="@style/EditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_margin="2dp"
            android:layout_weight="1"
            style="@style/TextInputLayout">
            <com.groboot.mdaemergency.ui.views.TimeField
                android:id="@+id/et_to"
                android:hint="עד שעה"
                style="@style/EditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textSize="22dp"
            android:id="@+id/tv_AmountHour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="28dp"
            android:textColor="#ff303030"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_wait"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/red_text"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/tv_error"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_wait"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="אנא המתן..."/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="6dp">
        <Button
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="דיווח יציאה ממשמרת"/>
        <Button
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_enter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="דיווח כניסה למשמרת"/>
        <Button
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="נסה שנית"/>
    </LinearLayout>
</LinearLayout>
