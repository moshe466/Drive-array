<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ll_main"
    android:background="@drawable/red_on_pressed"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <ImageView
        android:id="@+id/iv_user"
        android:padding="10dp"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:src="@drawable/user"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"
        android:layout_centerInParent="true"/>
    <ImageView
        android:padding="6dp"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:src="@drawable/button_oval_border_gray"
        android:layout_alignParentRight="true"
        android:layout_centerInParent="true"/>
    <ImageView
        android:gravity="left"
        android:id="@+id/iv_favorites"
        android:padding="18dp"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_marginRight="60dp"
        android:src="@drawable/favorites_gray"
        android:layout_alignParentLeft="true"/>
    <ImageView
        android:gravity="left"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:src="@drawable/button_oval_border_gray"
        android:layout_alignParentLeft="true"/>
    <ImageView
        android:gravity="left"
        android:id="@+id/iv_begin_ptt"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_marginRight="60dp"
        android:src="@drawable/ptt_play_1"
        android:layout_alignParentLeft="true"/>
    <ImageView
        android:gravity="left"
        android:id="@+id/iv_open_chanel"
        android:padding="14dp"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:src="@drawable/ptt_play_0"
        android:layout_alignParentLeft="true"/>
    <ProgressBar
        android:gravity="left"
        android:id="@+id/pb_ptt"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_marginRight="60dp"
        android:layout_alignParentLeft="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="65dp">
        <TextView
            android:textSize="18dp"
            android:gravity="bottom|right"
            android:id="@+id/tv_name"
            android:paddingLeft="50dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="a h h g g g u y yt t t t t t t t t d f h"
            android:layout_weight="1"/>
        <TextView
            android:textSize="22dp"
            android:gravity="top|right"
            android:id="@+id/tv_number"
            android:paddingLeft="50dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="ashsdfhdfh"
            android:layout_weight="0.8"/>
    </LinearLayout>
</RelativeLayout>
