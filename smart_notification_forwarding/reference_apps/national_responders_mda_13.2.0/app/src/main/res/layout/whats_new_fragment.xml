<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp">
        <TextView
            android:textColor="@color/red_text"
            android:gravity="right"
            android:id="@+id/tv_1"
            android:background="@drawable/on_preesed_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="מיקומים"
            style="@style/redTitleStyle"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:gravity="right"
                android:layout_gravity="top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="ביטול סטטוסים - בית, עבודה, כתובת שונה"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:src="@drawable/oval_border__gray_dark"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <TextView
            android:textColor="@color/red_text"
            android:gravity="right"
            android:id="@+id/tv_2"
            android:background="@drawable/on_preesed_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="רוכבי אופנועים"
            style="@style/redTitleStyle"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:gravity="right"
                android:layout_gravity="top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="פתיחה וסגירת שורות כונן"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:src="@drawable/oval_border__gray_dark"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <TextView
            android:textColor="@color/red_text"
            android:gravity="right"
            android:id="@+id/tv_3"
            android:background="@drawable/on_preesed_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="כוננים"
            style="@style/redTitleStyle"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:gravity="right"
                android:layout_gravity="top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="תיקון באג: "/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:src="@drawable/oval_border__gray_dark"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:gravity="right"
                android:layout_gravity="top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="הודעה קופצת בקבלת קריאות כונן למכשיר"/>
        </RelativeLayout>
        <TextView
            android:textStyle="bold"
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="חוברת הסבר מפורטת אודות השינויים באפליקציה תופץ לכלל המשתמשים"/>
        <TextView
            android:textStyle="bold"
            android:gravity="right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="חלק מהשינויים מופיעים בהתאם להרשאות המשתמש"/>
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"/>
    </LinearLayout>
</ScrollView>
