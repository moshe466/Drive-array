<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rdg_family_member_isolation_confirmatio_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_family_member_isolation_confirmation_title"
        app:layout_constraintVertical_bias="0">
        <RadioButton
            android:id="@+id/rdb_deny_family_isolation"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/no"
            android:layout_weight="1"
            android:layoutDirection="rtl"/>
        <RadioButton
            android:id="@+id/rdb_confirm_family_isolation"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:text="@string/yes"
            android:layout_weight="1"
            android:layoutDirection="rtl"/>
    </RadioGroup>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/txv_family_member_isolation_confirmation_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minWidth="70dp"
        android:text="@string/family_member_isolation_confirmation"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
