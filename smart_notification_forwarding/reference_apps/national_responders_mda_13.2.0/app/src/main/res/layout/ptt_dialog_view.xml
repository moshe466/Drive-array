<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:background="@color/ptt_play_green"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <RelativeLayout
        android:orientation="vertical"
        android:background="#f9ffffff"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp">
        <RelativeLayout
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true">
            <ImageView
                android:gravity="left"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/button_oval_border_gray"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:gravity="left"
                android:id="@+id/iv_play"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ptt_play"
                android:layout_alignParentLeft="true"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/pb_wait"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="30dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <SeekBar
            android:id="@+id/sb_volume"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="140dp"
            android:max="15"
            android:progress="5"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#ffd03030"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_message"
            android:background="#00000000"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="74dp"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="74dp">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/black"
                android:gravity="right"
                android:id="@+id/tv_name"
                android:padding="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="dfg hgfjh"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/mada_red"
                android:gravity="right"
                android:id="@+id/tv_name2"
                android:padding="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="dfg hgfjh"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#ff303030"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_status"
            android:background="#00000000"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="74dp"
            android:text="זמין"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:id="@+id/ll_error"
            android:background="#ffa91d26"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="fgfgfg"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/iv_close"
            android:padding="9dp"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/button_x"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
    </RelativeLayout>
</RelativeLayout>
