<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_filter"
                android:background="#ffeeeeee"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_margin="4dp"
                android:layout_alignParentTop="true">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:padding="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="filter"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"/>
                <TextView
                    android:textSize="22dp"
                    android:gravity="bottom|left"
                    android:id="@+id/tv_filter"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginRight="50dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"/>
                <Button
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/btn_filter_ok"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:text="ok"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <ListView
                android:id="@+id/lv_test_log"
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="#ffe8ecf4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_log"
                android:background="@color/white"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Log"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true">
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_test_log_clear"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="clear"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_test_log_refresh"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="refresh"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_filter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="filter"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_server"
                android:background="@color/white"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Server"/>
                <EditText
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/et_server"
                    android:background="#ffdddddd"
                    android:paddingLeft="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true">
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_server_1"
                        android:tag="0"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="production"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_server_2"
                        android:tag="1"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="dev"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_server_3"
                        android:tag="2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="debug"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true">
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_server_4"
                        android:tag="3"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="מרגלית"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_server_5"
                        android:tag="4"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="מוריה"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_server_6"
                        android:tag="5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="נעה"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_sendToken"
                android:background="@color/white"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Push"/>
                <EditText
                    android:id="@+id/et_push_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:text=""
                    android:hint="test message"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true">
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_send_token2"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="send"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_send_ptt_sound"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="ptt sound"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="10dp"
                        android:gravity="center"
                        android:id="@+id/btn_check_token"
                        android:padding="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="1dp"
                        android:text="check token"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/btn_log"
                    android:background="@color/white"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:text="Log"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/btn_server"
                    android:background="@color/white"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:text="Server"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/btn_send_token"
                    android:background="@color/white"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:text="push"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:gravity="top|center_horizontal"
                    android:layout_gravity="top"
                    android:id="@+id/btn_app_type"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:text="@string/app_name_ih"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/tv_close"
                    android:background="@color/white"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:text="close"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
