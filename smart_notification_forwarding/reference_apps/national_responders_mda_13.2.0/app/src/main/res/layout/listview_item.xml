<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_choose"
        android:visibility="visible"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/button_menu_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:paddingTop="3dp"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/user_status_2"
        app:layout_constraintBottom_toBottomOf="@+id/img_choose"
        app:layout_constraintEnd_toEndOf="@+id/img_choose"
        app:layout_constraintStart_toStartOf="@+id/img_choose"
        app:layout_constraintTop_toTopOf="@+id/img_choose"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/red_text"
        android:id="@+id/tv_text"
        android:padding="4dp"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="זמין - משדר זמינות"
        android:maxLines="2"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
