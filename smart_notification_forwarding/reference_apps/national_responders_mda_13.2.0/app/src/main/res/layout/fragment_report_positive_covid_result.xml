<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/mada_red"
            android:layout_gravity="center"
            android:id="@+id/txv_report_expo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_report_positive_result_text"/>
        <Button
            android:id="@+id/btn_add_positive_report"
            android:background="@drawable/secondary_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/add_report"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linv_add_positive_report_form"
            android:background="@drawable/isolation_history_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.fragment.app.FragmentContainerView
                android:name="com.groboot.mdaemergency.ui.isolation_report_system.fragments.covid_exposure.ExpoDescriptionFragment"
                android:id="@+id/frg_pos_exposure_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.fragment.app.FragmentContainerView
                android:name="com.groboot.mdaemergency.ui.isolation_report_system.fragments.covid_exposure.ExposureLocationFragment"
                android:id="@+id/frg_pos_exposure_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.fragment.app.FragmentContainerView
                android:name="com.groboot.mdaemergency.ui.isolation_report_system.fragments.covid_exposure.SetIsolationPeriodButtonFragment"
                android:id="@+id/frg_pos_set_isolation_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>
            <com.groboot.mdaemergency.ui.isolation_report_system.views.generic_views.SaveCancelFormView
                android:id="@+id/scf_save_cancel_pos_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <TextView
            android:textSize="20sp"
            android:id="@+id/txv_iso_history_title"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/iso_history_title_text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_positive_reports_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/txv_no_isolation_history"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_isolation_history"/>
    </LinearLayout>
</ScrollView>
