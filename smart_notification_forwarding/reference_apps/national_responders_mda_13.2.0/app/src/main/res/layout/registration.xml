<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView xmlns:float="http://schemas.android.com/apk/res-auto"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_logo"
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:layout_margin="10dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/sign_up_logo"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/v_ih"
                        android:layout_width="1dp"
                        android:layout_height="40dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="50dp">
                        <TextView
                            android:textSize="18dp"
                            android:textColor="@color/red_text"
                            android:layout_gravity="bottom"
                            android:id="@+id/registration_title"
                            android:padding="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_alignParentStart="true"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/rl_vehicle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ll_title">
                    <RelativeLayout
                        android:id="@+id/vehicle_layout"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:background="@drawable/sign_up_text_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"/>
                        <ImageView
                            android:id="@+id/vehicle_icon"
                            android:layout_width="20dp"
                            android:layout_height="16dp"
                            android:layout_marginBottom="11dp"
                            android:src="@drawable/vehicle_icon"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <EditText
                                android:gravity="start|bottom"
                                android:id="@+id/et_vehicle_number"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="11dp"
                                android:hint="@string/vehicle_number"
                                android:inputType="text"
                                android:layout_marginEnd="25dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/vehicle_coce_layout"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_below="@+id/vehicle_layout"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:background="@drawable/sign_up_text_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"/>
                        <ImageView
                            android:id="@+id/vehicle_coce_icon"
                            android:layout_width="20dp"
                            android:layout_height="16dp"
                            android:layout_marginBottom="11dp"
                            android:src="@drawable/vehicle_icon"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <EditText
                                android:gravity="start|bottom"
                                android:id="@+id/et_vehicle_coce"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="11dp"
                                android:hint="@string/vehicle_operation_code"
                                android:inputType="number"
                                android:layout_marginEnd="25dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_crew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ll_title">
                    <RelativeLayout
                        android:id="@+id/phone_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:background="@drawable/sign_up_text_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"/>
                        <ImageView
                            android:id="@+id/phone_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="11dp"
                            android:src="@drawable/sign_up_phone_icon"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <EditText
                                android:gravity="start|bottom"
                                android:id="@+id/et_phone"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="11dp"
                                android:hint="@string/phone"
                                android:inputType="number"
                                android:layout_marginEnd="25dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/pid_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_below="@+id/phone_layout"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:background="@drawable/sign_up_text_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"/>
                        <ImageView
                            android:id="@+id/pid_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="11dp"
                            android:src="@drawable/sign_up_id_icon"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <EditText
                                android:gravity="start|bottom"
                                android:id="@+id/et_pid"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="11dp"
                                android:hint="@string/pid"
                                android:inputType="number"
                                android:layout_marginEnd="25dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/birthday_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_below="@+id/pid_layout"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:background="@drawable/sign_up_text_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"/>
                        <ImageView
                            android:id="@+id/birthday_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="11dp"
                            android:src="@drawable/sign_up_date_icon"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <EditText
                                android:gravity="start|bottom"
                                android:id="@+id/et_birthday"
                                android:background="@null"
                                android:focusable="false"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="11dp"
                                android:hint="@string/birthday"
                                android:inputType="none"
                                android:layout_marginEnd="25dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <View
                            android:id="@+id/view_birthday"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/id_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_below="@+id/birthday_layout"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:background="@drawable/sign_up_text_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"/>
                        <ImageView
                            android:id="@+id/id_icon"
                            android:background="@drawable/sign_up_code_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="11dp"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <EditText
                                android:gravity="start|bottom"
                                android:id="@+id/et_konan_id"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="11dp"
                                android:hint="@string/konan_id"
                                android:inputType="number"
                                android:layout_marginEnd="25dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/is_konan"
                        android:paddingTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/konan_checkbox_title"
                        android:drawablePadding="5dp"
                        android:layout_below="@+id/id_layout"
                        android:drawableStart="@drawable/sign_up_check_box"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_alignParentStart="true"/>
                    <RelativeLayout
                        android:id="@+id/sms_code_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/is_konan">
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/red_text"
                            android:gravity="center"
                            android:id="@+id/thank_you_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/registration_thank_you"
                            android:layout_centerHorizontal="true"/>
                        <TextView
                            android:textColor="@color/red_text"
                            android:gravity="center"
                            android:id="@+id/thank_you_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/registration_sms_code"
                            android:layout_below="@+id/thank_you_title"
                            android:layout_centerHorizontal="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>
                        <EditText
                            android:textColor="@color/green_buttons"
                            android:gravity="center"
                            android:id="@+id/sms_code_edit_text"
                            android:background="@drawable/sign_up_sms_box_new"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/thank_you_content"
                            android:inputType="number"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_buttons"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="100dp">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#ff4caf50"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_callMe"
                android:paddingLeft="100dp"
                android:paddingRight="100dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/callMe"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_call_green_24dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="44dp">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/sign_up_again_btn"
                    android:background="@drawable/red_btn_selector"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/i_dont_get_sms"
                    android:layout_centerHorizontal="true"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn_permission"
                    android:background="@drawable/red_btn_selector"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/permission"
                    android:layout_centerHorizontal="true"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/sign_up_btn"
                    android:background="@drawable/red_btn_selector"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/procced"
                    android:layout_weight="1"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/iv_registrationByVehicle"
                    android:background="@drawable/red_btn_selector"
                    android:padding="8dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/vehicle_icon"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_registrationByUser"
                    android:background="@drawable/red_btn_selector"
                    android:padding="4dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/user"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_welcome"
        android:background="#ffffffff"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_printer"
            android:background="@drawable/border_button"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <TextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/blue_text"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="הגדרת מדפסת"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/mada_red"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="עבור דוגמי קורונה בלבד"
                android:singleLine="false"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/btn_hide_welcome"
            android:background="@drawable/border_button"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <TextView
                android:textSize="27dp"
                android:textStyle="bold"
                android:textColor="@color/blue_text"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/enter_app"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/mada_red"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/to_mda_and_loyal_life"
                android:singleLine="false"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_life_register"
        android:background="#ffffffff"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <WebView
            android:id="@+id/wv_life"
            android:background="#ffcccccc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="50dp"
            android:layout_weight="1"/>
        <RelativeLayout
            android:id="@+id/pb_wait"
            android:background="#88000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="50dp">
            <ProgressBar
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <Button
            android:textSize="20dp"
            android:textColor="@color/white"
            android:id="@+id/btn_end_register"
            android:background="#ffed1c24"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="@string/finish_registration"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_registration_buttons"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:layout_width="160dp"
            android:layout_height="80dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_registrationByVehicle2"
                android:background="@drawable/red_btn_selector"
                android:paddingTop="6dp"
                android:paddingBottom="30dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/vehicle_icon"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registration_by_vehicle"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="160dp"
            android:layout_height="80dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_registrationByUser2"
                android:background="@drawable/red_btn_selector"
                android:paddingTop="4dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/user"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registration_by_user"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
