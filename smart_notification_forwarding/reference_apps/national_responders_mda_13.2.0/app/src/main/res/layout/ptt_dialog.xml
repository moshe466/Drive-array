<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:background="@color/ptt_play_green"
    android:padding="2dp"
    android:layout_width="300dp"
    android:layout_height="300dp">
    <RelativeLayout
        android:orientation="vertical"
        android:background="#d0ffffff"
        android:layout_width="296dp"
        android:layout_height="296dp">
        <RelativeLayout
            android:layout_gravity="center"
            android:background="#0000aa00"
            android:layout_width="match_parent"
            android:layout_height="296dp"
            android:baselineAligned="false">
            <View
                android:id="@+id/v_v"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_weight="1"/>
            <ProgressBar
                android:id="@+id/pb_wait"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:id="@+id/iv_status_online"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oval_green"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:id="@+id/iv_status_offline"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oval_red"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:id="@+id/iv_status_other"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/oval_yellow"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/iv_close"
                android:padding="7dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/button_x"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="30dp">
                <TextView
                    android:textSize="18dp"
                    android:textColor="@color/black"
                    android:gravity="bottom|center_horizontal"
                    android:id="@+id/tv_name"
                    android:padding="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/mada_red"
                    android:gravity="top|center_horizontal"
                    android:id="@+id/tv_name2"
                    android:padding="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="94dp"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true">
                <ImageView
                    android:gravity="left"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/button_oval_border_gray"
                    android:layout_alignParentLeft="true"/>
                <ImageView
                    android:gravity="left"
                    android:id="@+id/iv_play"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ptt_play"
                    android:layout_alignParentLeft="true"/>
            </RelativeLayout>
            <TextView
                android:textStyle="bold"
                android:textColor="#ffd03030"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_message"
                android:background="#00000000"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:minHeight="26dp"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="65dp"
                android:text="sdfgds"
                android:layout_alignParentBottom="true"/>
            <SeekBar
                android:id="@+id/sb_volume"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:max="15"
                android:progress="5"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/ll_log"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="230dp"
            android:layout_weight="1">
            <ListView
                android:id="@+id/lv_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="46dp"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_send"
                android:padding="6dp"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/ic_send"
                android:text="send"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"/>
            <EditText
                android:id="@+id/et_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="46dp"
                android:text="fd hgdfhg dgh fgjfg hj f nh fjf hfgj fgj f f f"
                android:hint="הקלד טקסט"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
