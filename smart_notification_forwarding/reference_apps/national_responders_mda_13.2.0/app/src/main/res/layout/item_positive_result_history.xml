<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/isolation_history_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/blue_text"
        android:id="@+id/txv_pos_res_serial_number"
        android:background="@drawable/isolation_serial_number_bg"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/txv_positive_test_date_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/positive_test_result_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txv_pos_expo_description_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_pos_res_serial_number"/>
    <TextView
        android:textColor="@color/blue_text"
        android:id="@+id/txv_positive_test_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/txv_positive_test_date_title"
        app:layout_constraintEnd_toStartOf="@+id/txv_positive_test_date_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_pos_res_serial_number"/>
    <TextView
        android:id="@+id/txv_pos_expo_description_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/expo_description_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txv_pos_expo_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_positive_test_date_title"/>
    <TextView
        android:textColor="@color/blue_text"
        android:id="@+id/txv_pos_expo_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txv_pos_expo_location_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_pos_expo_description_title"/>
    <TextView
        android:id="@+id/txv_pos_expo_location_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/expo_location_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txv_pos_expo_location_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_pos_expo_description"/>
    <TextView
        android:textColor="@color/blue_text"
        android:id="@+id/txv_pos_expo_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/txv_pos_expo_location_title"
        app:layout_constraintEnd_toStartOf="@+id/txv_pos_expo_location_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv_pos_expo_location_title"/>
    <TextView
        android:textColor="@color/blue_text"
        android:id="@+id/txv_pos_expo_location_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txv_iso_start_date_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_pos_expo_location_title"/>
    <TextView
        android:id="@+id/txv_iso_start_date_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/iso_from_fate_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txv_iso_end_date_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_pos_expo_location_description"/>
    <TextView
        android:textColor="@color/blue_text"
        android:id="@+id/txv_iso_start_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/txv_iso_start_date_title"
        app:layout_constraintEnd_toStartOf="@+id/txv_iso_start_date_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv_iso_start_date_title"/>
    <TextView
        android:id="@+id/txv_iso_end_date_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/iso_until_date_text"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_iso_start_date_title"/>
    <TextView
        android:textColor="@color/blue_text"
        android:id="@+id/txv_iso_end_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txv_iso_end_date_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv_iso_end_date_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
