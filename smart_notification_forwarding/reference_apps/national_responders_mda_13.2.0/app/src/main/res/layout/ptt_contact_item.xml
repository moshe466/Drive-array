<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ll_main"
    android:background="@drawable/red_on_pressed"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <ImageView
        android:id="@+id/iv_user"
        android:padding="10dp"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:src="@drawable/user"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"
        android:layout_centerInParent="true"/>
    <ImageView
        android:padding="6dp"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:src="@drawable/button_oval_border_gray"
        android:layout_alignParentRight="true"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/iv_available"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_margin="7dp"
        android:src="@drawable/oval_green"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:gravity="left"
        android:id="@+id/iv_favorites"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="match_parent"
        android:layout_marginRight="60dp"
        android:src="@drawable/favorites_gray"
        android:layout_alignParentLeft="true"/>
    <Button
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="center"
        android:id="@+id/buttonOptions"
        android:background="@android:color/transparent"
        android:paddingLeft="16dp"
        android:layout_width="45dp"
        android:layout_height="match_parent"
        android:text="⋮"
        android:layout_alignParentLeft="true"/>
    <com.groboot.mdaemergency.ui.VolumeView
        android:id="@+id/vv_volume"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="46dp"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textSize="18dp"
        android:gravity="top|right"
        android:id="@+id/tv_name"
        android:paddingLeft="90dp"
        android:paddingTop="4dp"
        android:paddingRight="65dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="22dp"
        android:gravity="bottom|right"
        android:id="@+id/tv_number"
        android:paddingLeft="90dp"
        android:paddingRight="65dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
