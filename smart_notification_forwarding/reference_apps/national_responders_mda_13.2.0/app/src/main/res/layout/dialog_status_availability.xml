<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/border_squer_green"
    android:padding="16dp"
    android:layout_width="300dp"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/close"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/green_two"
            android:id="@+id/choose_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/choose_status_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/choose_status_explanation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/choose_status"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_enterAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/grd_items">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_autocomplete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <com.groboot.mdaemergency.ui.views.ClearableAutoCompleteTextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:id="@+id/autocomplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_address"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:drawablePadding="5dp"
                    android:inputType="text"
                    android:dropDownAnchor="@+id/choose_status_explanation"
                    android:imeOptions="actionSearch"
                    android:dropDownHeight="200dp"
                    android:backgroundTint="@color/green_buttons"/>
            </com.google.android.material.textfield.TextInputLayout>
            <ProgressBar
                android:id="@+id/pb_getLocation"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:indeterminateTint="@color/green_buttons"
                android:indeterminateTintMode="src_atop"
                app:layout_constraintBottom_toBottomOf="@+id/til_autocomplete"
                app:layout_constraintTop_toTopOf="@+id/til_autocomplete"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tv_userLocation"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="המיקום שלך"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/map_location"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/til_autocomplete"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <GridView
            android:id="@+id/grd_items"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:horizontalSpacing="0dp"
            android:verticalSpacing="0dp"
            android:stretchMode="columnWidth"
            android:numColumns="4"
            android:maxHeight="10dp"
            android:divider="@color/mada_red"
            android:dividerHeight="1dp"
            app:layout_constraintTop_toBottomOf="@+id/choose_status_explanation"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ll_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:layout_constraintTop_toBottomOf="@+id/cl_enterAddress">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pb_save"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:indeterminateTint="@color/green_two"
                android:indeterminateTintMode="src_atop"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/green_two"
                android:gravity="end"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
